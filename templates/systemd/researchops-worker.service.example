[Unit]
Description=ResearchOps worker
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
WorkingDirectory=__APP_DIR__
Environment=RESEARCHOPS_CONFIG=__CONFIG_PATH__
ExecStart=__VENV_DIR__/bin/researchctl worker start
Restart=on-failure
RestartSec=10s
RestartPreventExitStatus=78
TimeoutStopSec=45s
KillMode=control-group
Delegate=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=__DATA_DIR__ __LOG_DIR__
# These paths are for the application parent, not the Codex child security boundary.
# The child launcher must expose only the current task project/ and current invocation
# phase staging as RWX task data; hide other phases, tasks, DB, archive/outbox and secrets.
# Keep the required runtime/toolchain read-only.
# Close inherited application file descriptors and pass an allowlisted environment.
# Track each research/compose invocation in a launcher-owned process group/cgroup.
# The reference launcher uses a delegated cgroup v2 child per invocation and waits
# for cgroup.events populated=0 before advancing or releasing the workspace lock.
# Confirm invocation-stage descendants exit before the next phase or output import; confirm all
# old descendants exit and release the workspace lock before stale recovery.

[Install]
WantedBy=multi-user.target
