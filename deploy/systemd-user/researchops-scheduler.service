[Unit]
Description=ResearchOps Seoul schedule tick (explicit timer activation only)
AssertPathExists=@ROOT@/config/settings.yaml
AssertPathExists=@ROOT@/current/.venv/bin/researchctl
AssertPathIsDirectory=@ROOT@/data

[Service]
Type=oneshot
WorkingDirectory=@ROOT@
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TZ=Asia/Seoul
Environment=RESEARCHOPS_ROOT=@ROOT@/current
Environment=RESEARCHOPS_CONFIG=@ROOT@/config/settings.yaml
ExecStart=@ROOT@/current/.venv/bin/researchctl --config @ROOT@/config/settings.yaml schedule tick
UMask=0077
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
LimitCORE=0
LimitNOFILE=4096
TasksMax=32
MemoryHigh=128M
MemoryMax=256M
MemorySwapMax=0
KillMode=control-group
TimeoutStartSec=120
TimeoutStopSec=45
Restart=no
StandardOutput=journal
StandardError=journal
SyslogIdentifier=researchops-scheduler
# No Install section: only the explicitly enabled timer invokes this service.
