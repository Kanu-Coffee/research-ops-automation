{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/researchops/delivery-request.schema.json",
  "title": "ResearchOps Built-in SMTP Package v2",
  "type": "object",
  "required": [
    "schema_version",
    "handoff_id",
    "idempotency_key",
    "task_id",
    "run_id",
    "task_version_hash",
    "message_revision",
    "message_type",
    "recipient_group_id",
    "subject",
    "body",
    "attachments",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "handoff_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,255}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "task_version_hash": {
      "$ref": "#/$defs/sha256"
    },
    "message_revision": {
      "type": "integer",
      "minimum": 1
    },
    "message_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,31}$"
    },
    "recipient_group_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 998,
      "pattern": "^[^\\r\\n]+$"
    },
    "body": {
      "type": "object",
      "required": [
        "html",
        "text"
      ],
      "properties": {
        "html": {
          "$ref": "#/$defs/htmlFile"
        },
        "text": {
          "$ref": "#/$defs/textFile"
        }
      },
      "additionalProperties": false
    },
    "attachments": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/attachmentFile"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "composition_binding_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$comment": "Immutable worker-safe package containing an opaque group signal. The built-in SMTP dispatcher resolves approved recipients outside worker and archive boundaries, preserves original body bytes, and stores a separate protected envelope/MIME snapshot. Publication does not imply SMTP acceptance. Logical message revisions reuse their idempotency key.",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "baseFile": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "media_type",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "media_type": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9!#$&^_.+-]+/[a-zA-Z0-9!#$&^_.+-]+$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 26214400
        }
      }
    },
    "htmlFile": {
      "allOf": [
        {
          "$ref": "#/$defs/baseFile"
        },
        {
          "type": "object",
          "properties": {
            "media_type": {
              "const": "text/html"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "textFile": {
      "allOf": [
        {
          "$ref": "#/$defs/baseFile"
        },
        {
          "type": "object",
          "properties": {
            "media_type": {
              "const": "text/plain"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "attachmentFile": {
      "allOf": [
        {
          "$ref": "#/$defs/baseFile"
        },
        {
          "type": "object",
          "properties": {
            "filename": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[^\\r\\n/\\\\]+$"
            },
            "disposition": {
              "enum": [
                "attachment",
                "inline"
              ]
            },
            "content_id": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          },
          "required": [
            "filename",
            "disposition"
          ]
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "additionalProperties": false
}
