{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/researchops/delivery-receipt.schema.json",
  "title": "ResearchOps SMTP Evidence and Legacy Receipt v2",
  "type": "object",
  "required": [
    "schema_version",
    "external_receipt_id",
    "handoff_id",
    "idempotency_key",
    "delivery_request_sha256",
    "status",
    "occurred_at",
    "proof"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "external_receipt_id": {"type": "string", "minLength": 1, "maxLength": 255},
    "handoff_id": {"type": "string", "minLength": 1, "maxLength": 255},
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "delivery_request_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["accepted", "sent", "smtp_accepted", "failed", "uncertain"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "external_message_ref": {"type": ["string", "null"], "maxLength": 2000},
    "error": {
      "type": ["object", "null"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 255},
        "message": {"type": "string", "minLength": 1, "maxLength": 4000},
        "retryable": {"type": "boolean"}
      },
      "required": ["code", "message", "retryable"],
      "additionalProperties": false
    },
    "proof": {
      "type": "object",
      "required": ["type", "issuer"],
      "properties": {
        "type": {"enum": ["detached_signature", "authenticated_channel", "test_fixture", "local_smtp_attempt"]},
        "issuer": {"type": "string", "minLength": 1, "maxLength": 255},
        "key_id": {"type": ["string", "null"], "maxLength": 255},
        "value": {"type": ["string", "null"], "maxLength": 16384}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "failed"}}, "required": ["status"]},
      "then": {"properties": {"error": {"type": "object"}}, "required": ["error"]}
    },
    {
      "if": {"properties": {"status": {"const": "sent"}}, "required": ["status"]},
      "then": {"properties": {"error": {"type": "null"}}}
    }
  ],
  "$comment": "Legacy imported receipts, including test_fixture, are untrusted audit evidence only and never alter handoff/run/reported state. local_smtp_attempt is created only by the dispatcher transaction and cannot be imported. smtp_accepted means all RCPT commands and final DATA were accepted by the SMTP server, not recipient-inbox delivery.",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
